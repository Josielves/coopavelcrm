<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CRM · Coopavel</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>

    <!-- ══ LOGIN ══════════════════════════════════════════ -->
    <section class="login-screen" id="loginScreen">
      <form class="login-card" id="loginForm">
        <img class="brand-logo login-logo" src="assets/logo-coopavel.png" alt="Coopavel" />
        <div>
          <p class="eyebrow">Acesso restrito</p>
          <h1>CRM de equipamentos</h1>
        </div>
        <label>
          Usuário
          <input name="username" required autocomplete="username" placeholder="admin" />
        </label>
        <label>
          Senha
          <input name="password" required type="password" autocomplete="current-password" placeholder="••••••••" />
        </label>
        <p class="form-error" id="loginError"></p>
        <button class="primary" type="submit">Entrar</button>
        <p class="hint">Primeiro acesso: admin / admin123</p>
      </form>
    </section>

    <!-- ══ APP ════════════════════════════════════════════ -->
    <section class="crm-app hidden" id="crmApp">

      <!-- Top bar -->
      <header class="topbar">
        <div class="brand-lockup">
          <img class="brand-logo topbar-logo" src="assets/logo-coopavel.png" alt="Coopavel" />
          <div>
            <p class="eyebrow">Administração industrial</p>
            <h1>CRM de equipamentos</h1>
          </div>
        </div>
        <div class="topbar-actions">
          <span class="user-pill" id="currentUserLabel"></span>
          <button class="ghost" id="exportBtn" type="button">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 10v3a1 1 0 01-1 1H3a1 1 0 01-1-1v-3"/><path d="M8 10V2"/><path d="M5 5l3-3 3 3"/>
            </svg>
            Exportar
          </button>
          <label class="ghost import-btn" for="importInput">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 10v3a1 1 0 01-1 1H3a1 1 0 01-1-1v-3"/><path d="M8 2v8"/><path d="M5 7l3 3 3-3"/>
            </svg>
            Importar
          </label>
          <input id="importInput" type="file" accept="application/json" />
          <button class="ghost" id="logoutBtn" type="button">Sair</button>
          <button class="primary" id="newEquipmentBtn" type="button" data-permission="write">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M8 2v12M2 8h12"/>
            </svg>
            Novo equipamento
          </button>
        </div>
      </header>

      <main class="app-shell">

        <!-- Sidebar -->
        <aside class="sidebar" aria-label="Menu do CRM">
          <nav class="main-nav">
            <button class="nav-btn active" type="button" data-view="equipments">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="14" height="10" rx="1.5"/><path d="M5 7h6M5 9.5h4"/></svg>
              Equipamentos
            </button>
            <button class="nav-btn" type="button" data-view="products">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 1l7 4v6l-7 4-7-4V5z"/><path d="M8 1v14M1 5l7 4 7-4"/></svg>
              Produtos
            </button>
            <button class="nav-btn" type="button" data-view="stock">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="8" width="4" height="6" rx="1"/><rect x="6" y="4" width="4" height="10" rx="1"/><rect x="10" y="1" width="4" height="13" rx="1"/></svg>
              Estoque
            </button>
            <button class="nav-btn" type="button" data-view="preventives">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="12" height="13" rx="1.5"/><path d="M5 2V1M11 2V1M2 6h12"/><path d="M5.5 9.5l1.5 1.5 3-3"/></svg>
              Preventivas
            </button>
            <button class="nav-btn" type="button" data-view="users" data-permission="manageUsers">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="5" r="2.5"/><path d="M1 13.5c0-2.8 2.2-5 5-5s5 2.2 5 5"/><circle cx="12" cy="5" r="2"/><path d="M10.5 10.5c.5-.2 1-.3 1.5-.3 1.9 0 3.5 1.6 3.5 3.5"/></svg>
              Usuários
            </button>
          </nav>

          <div class="search-box">
            <label for="searchInput">Buscar equipamentos</label>
            <input id="searchInput" type="search" placeholder="Nome, fabricante, modelo…" />
          </div>

          <div class="sidebar-title">
            <span>Equipamentos</span>
            <strong id="equipmentCount">0</strong>
          </div>

          <div class="equipment-list" id="equipmentList"></div>
        </aside>

        <!-- Main workspace -->
        <section class="workspace" aria-live="polite">
          <div id="viewRoot"></div>
        </section>

      </main>
    </section>

    <!-- ══ MODALS ══════════════════════════════════════════ -->

    <!-- Equipment -->
    <dialog id="equipmentDialog" class="modal">
      <form method="dialog" class="modal-card" id="equipmentForm">
        <div class="modal-header">
          <div>
            <p class="eyebrow">Cadastro</p>
            <h2 id="equipmentDialogTitle">Novo equipamento</h2>
          </div>
          <button class="icon-btn" data-close-modal="equipmentDialog" type="button" aria-label="Fechar">×</button>
        </div>
        <div class="form-grid">
          <label>
            Nome da máquina
            <input name="name" required placeholder="Ex.: Prensa hidráulica PH-220" />
          </label>
          <label>
            Fabricante
            <input name="manufacturer" required placeholder="Ex.: Atlas Industrial" />
          </label>
          <label>
            Modelo
            <input name="model" required placeholder="Ex.: PH-220X" />
          </label>
          <label>
            Foto
            <input name="photo" type="file" accept="image/*" />
          </label>
          <label class="full">
            Especificações
            <textarea name="specs" rows="5" placeholder="Capacidade, tensão, pressão, potência, dimensões…"></textarea>
          </label>
        </div>
        <div class="modal-actions">
          <button class="ghost" data-close-modal="equipmentDialog" type="button">Cancelar</button>
          <button class="primary" id="saveEquipmentBtn" type="submit">Salvar equipamento</button>
        </div>
      </form>
    </dialog>

    <!-- Product/Component -->
    <dialog id="componentDialog" class="modal">
      <form method="dialog" class="modal-card" id="componentForm">
        <div class="modal-header">
          <div>
            <p class="eyebrow" id="componentCategoryLabel">Produto</p>
            <h2 id="componentDialogTitle">Novo produto</h2>
          </div>
          <button class="icon-btn" data-close-modal="componentDialog" type="button" aria-label="Fechar">×</button>
        </div>
        <div class="form-grid">
          <label>
            Nome do produto
            <input name="name" required placeholder="Ex.: Válvula direcional" />
          </label>
          <label>
            Fabricante
            <input name="manufacturer" required placeholder="Ex.: Bosch Rexroth" />
          </label>
          <label>
            Modelo
            <input name="model" required placeholder="Ex.: 4WE6D" />
          </label>
          <label>
            Foto
            <input name="photo" type="file" accept="image/*" />
          </label>
          <label class="full">
            Especificações
            <textarea name="specs" rows="5" placeholder="Pressão, vazão, tensão, material, código interno…"></textarea>
          </label>
        </div>
        <div class="modal-actions">
          <button class="ghost" data-close-modal="componentDialog" type="button">Cancelar</button>
          <button class="primary" id="saveComponentBtn" type="submit">Salvar produto</button>
        </div>
      </form>
    </dialog>

    <!-- Stock -->
    <dialog id="stockDialog" class="modal">
      <form method="dialog" class="modal-card" id="stockForm">
        <div class="modal-header">
          <div>
            <p class="eyebrow">Estoque</p>
            <h2 id="stockDialogTitle">Nova peça</h2>
          </div>
          <button class="icon-btn" data-close-modal="stockDialog" type="button" aria-label="Fechar">×</button>
        </div>
        <div class="form-grid">
          <label>
            Equipamento vinculado
            <select name="equipmentId" required></select>
          </label>
          <label>
            Produto/periférico vinculado
            <select name="componentId"></select>
          </label>
          <label>
            Nome da peça
            <input name="name" required placeholder="Ex.: Retentor do cilindro" />
          </label>
          <label>
            Fabricante
            <input name="manufacturer" required placeholder="Ex.: Parker" />
          </label>
          <label>
            Modelo/código
            <input name="model" required placeholder="Ex.: RK-220" />
          </label>
          <label>
            Localização
            <input name="location" placeholder="Ex.: Prateleira A3" />
          </label>
          <label>
            Quantidade
            <input name="quantity" min="0" required type="number" value="0" />
          </label>
          <label>
            Estoque mínimo
            <input name="minimum" min="0" required type="number" value="0" />
          </label>
          <label>
            Foto
            <input name="photo" type="file" accept="image/*" />
          </label>
          <label class="full">
            Especificações
            <textarea name="specs" rows="4" placeholder="Medidas, material, aplicação, observações de compra…"></textarea>
          </label>
        </div>
        <div class="modal-actions">
          <button class="ghost" data-close-modal="stockDialog" type="button">Cancelar</button>
          <button class="primary" type="submit">Salvar peça</button>
        </div>
      </form>
    </dialog>

    <!-- Preventive -->
    <dialog id="preventiveDialog" class="modal">
      <form method="dialog" class="modal-card" id="preventiveForm">
        <div class="modal-header">
          <div>
            <p class="eyebrow">Preventiva</p>
            <h2 id="preventiveDialogTitle">Nova preventiva</h2>
          </div>
          <button class="icon-btn" data-close-modal="preventiveDialog" type="button" aria-label="Fechar">×</button>
        </div>
        <div class="form-grid">
          <label>
            Equipamento
            <select name="equipmentId" required></select>
          </label>
          <label>
            Frequência
            <select name="frequency" required>
              <option value="Diária">Diária</option>
              <option value="Semanal">Semanal</option>
              <option value="Mensal">Mensal</option>
              <option value="Trimestral">Trimestral</option>
              <option value="Semestral">Semestral</option>
              <option value="Anual">Anual</option>
            </select>
          </label>
          <label>
            Título
            <input name="title" required placeholder="Ex.: Inspeção do sistema hidráulico" />
          </label>
          <label>
            Próxima execução
            <input name="dueDate" required type="date" />
          </label>
          <label>
            Responsável
            <select name="responsibleUserId" required></select>
          </label>
          <label>
            Status
            <select name="status" required>
              <option value="Pendente">Pendente</option>
              <option value="Em andamento">Em andamento</option>
              <option value="Concluída">Concluída</option>
            </select>
          </label>
          <label class="full">
            Atividades
            <textarea name="notes" rows="5" placeholder="Checklist, lubrificação, medições, peças necessárias…"></textarea>
          </label>
        </div>
        <div class="modal-actions">
          <button class="ghost" data-close-modal="preventiveDialog" type="button">Cancelar</button>
          <button class="primary" type="submit">Salvar preventiva</button>
        </div>
      </form>
    </dialog>

    <!-- Users -->
    <dialog id="userDialog" class="modal">
      <form method="dialog" class="modal-card" id="userForm">
        <div class="modal-header">
          <div>
            <p class="eyebrow">Usuários</p>
            <h2 id="userDialogTitle">Novo usuário</h2>
          </div>
          <button class="icon-btn" data-close-modal="userDialog" type="button" aria-label="Fechar">×</button>
        </div>
        <div class="form-grid">
          <label>
            Nome completo
            <input name="name" required placeholder="Ex.: João da Manutenção" />
          </label>
          <label>
            Usuário
            <input name="username" required placeholder="Ex.: joao" />
          </label>
          <label>
            Senha
            <input name="password" type="password" placeholder="Preencha para alterar" />
          </label>
          <label>
            Permissão
            <select name="role" required>
              <option value="admin">Administrador</option>
              <option value="tecnico">Técnico</option>
              <option value="consulta">Consulta</option>
            </select>
          </label>
        </div>
        <div class="modal-actions">
          <button class="ghost" data-close-modal="userDialog" type="button">Cancelar</button>
          <button class="primary" type="submit">Salvar usuário</button>
        </div>
      </form>
    </dialog>

    <script src="app.js"></script>
  </body>
</html>
